# Bu faylni ".env" nomi bilan nusxalab, o'z qiymatlaringizni kiriting.
# Haqiqiy .env fayli GitHub'ga yuklanmasligi kerak.

# @BotFather'dan olingan bot tokeni (majburiy)
BOT_TOKEN=123456789:replace_this_with_real_token

# Telegram setWebhook va Vercel bir xil ishlatadigan secret token
WEBHOOK_SECRET=replace_with_random_webhook_secret

# Ruxsat etilgan maksimal yuklab olish hajmi, megabaytlarda
MAX_DOWNLOAD_MB=20

# Bir vaqtning o'zida nechta ajratish jarayoni ishlashi mumkin
MAX_CONCURRENT_JOBS=1

# Lokal uchun ./tmp_jobs; Vercel'da /tmp/vocal_bot ishlatiladi
WORK_DIR=./tmp_jobs

# Ixtiyoriy: ma'lum separatsion model fayli
MODEL_FILENAME=
