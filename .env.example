# Bu faylni ".env" nomi bilan nusxalab, o'z qiymatlaringizni kiriting.
# .env fayli hech qachon GitHub'ga yuklanmasligi kerak!

# @BotFather'dan olingan bot tokeni (majburiy)
BOT_TOKEN=123456789:AAExampleTokenHereReplaceMe

# Ruxsat etilgan maksimal yuklab olish hajmi, megabaytlarda
# (standart Telegram Bot API cheklovi ~20MB)
MAX_DOWNLOAD_MB=20

# Bir vaqtning o'zida nechta ajratish jarayoni ishlashi mumkin
# (CPU'ga qarab 1 yoki 2 tavsiya etiladi)
MAX_CONCURRENT_JOBS=1

# Vaqtinchalik fayllar va model fayllari saqlanadigan papka
WORK_DIR=./tmp_jobs

# Ixtiyoriy: ma'lum bir separatsion modelni tanlash uchun
# (bo'sh qoldirilsa, kutubxonaning standart modeli ishlatiladi)
# Mavjud modellar ro'yxati: audio-separator --list_models
MODEL_FILENAME=
